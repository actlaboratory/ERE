#: addon\globalPlugins\ERE\updaterStrings.py:8
msgid ""
"Unable to connect to update server.\n"
"Check your internet connection."
msgstr ""
"アップデートサーバに接続できません。\n"
"インターネット接続をご確認ください。"

#: addon\globalPlugins\ERE\updaterStrings.py:9
msgid "Unable to connect to update server."
msgstr "アップデートサーバに接続できません。"

#: addon\globalPlugins\ERE\updaterStrings.py:10
msgid ""
"The update information is invalid.\n"
"Please contact ACT Laboratory for further information."
msgstr ""
"アップデート情報が誤っています。\n"
"ACT Laboratoryにお問い合わせください。"

#: addon\globalPlugins\ERE\updaterStrings.py:11
msgid "The request parameter is invalid. Please contact the developer."
msgstr "リクエストパラメータが不正です。開発者までご連絡ください。"

#: addon\globalPlugins\ERE\updaterStrings.py:12
msgid "Error downloading add-on update."
msgstr "アップデートのダウンロード中にエラーが発生しました。"

#: addon\globalPlugins\ERE\updaterStrings.py:13
#, python-format
msgid "Failed to open add-on package file at %s - missing file or invalid file format"
msgstr "%s のアドオンパッケージファイルを開けませんでした。ファイルが不足しているか、ファイル形式が誤っています。"

#: addon\globalPlugins\ERE\updaterStrings.py:14
#, python-format
msgid "Failed to update add-on  from %s."
msgstr "%sからのアップデートに失敗しました。"

#: addon\globalPlugins\ERE\updaterStrings.py:15
msgid ""
"No updates found.\n"
"You are using the latest version."
msgstr ""
"アップデートが見つかりませんでした。\n"
"最新版を使用中です。"

#: addon\globalPlugins\ERE\updaterStrings.py:16
msgid "The updater is not registered. Please contact the developer."
msgstr "アップデータが登録されていません。開発者までご連絡ください。"

#: addon\globalPlugins\ERE\updaterStrings.py:17
msgid "An update was found, but updating from the current version is not possible. Please visit the software's website. "
msgstr "アップデートが見つかりましたが、現在のバージョンから自動更新することはできまえｓん。ソフトウェアの詳細ページから、手動で更新を行ってください。"

#: addon\globalPlugins\ERE\updaterStrings.py:18
msgid "Update check"
msgstr "アップデートの確認"

#: addon\globalPlugins\ERE\updaterStrings.py:19
msgid "Update confirmation"
msgstr "アップデートの確認"

