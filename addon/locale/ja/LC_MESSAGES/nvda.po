msgid "Report Misreadings"
msgstr "読み間違いの報告"

#: addon\globalPlugins\ERE\__init__.py:121
msgid "Report words that cannot be read correctly in English Reading Enhancer."
msgstr "English Reading Enhancerで正しく読めない単語を報告します。"

#: addon\globalPlugins\ERE\__init__.py:123
#: addon\globalPlugins\ERE\__init__.py:307
msgid "Set GitHub Access Token"
msgstr "GitHub アクセス トークンの設定"

#: addon\globalPlugins\ERE\__init__.py:123
msgid "Enter your personal GitHub access token."
msgstr "個人用GitHub アクセス トークンを入力します。"

#: addon\globalPlugins\ERE\__init__.py:125
msgid "Open Report List"
msgstr "報告一覧を開く"

#: addon\globalPlugins\ERE\__init__.py:125
msgid "Open the list of received reports in your browser."
msgstr "受信した報告の一覧をブラウザーで開きます。"

#: addon\globalPlugins\ERE\__init__.py:131
msgid "Disable checking for updates on startup"
msgstr "起動時のアップデートチェックを無効化"

#: addon\globalPlugins\ERE\__init__.py:131
msgid "Enable checking for updates on startup"
msgstr "起動時のアップデートチェックを有効化"

#: addon\globalPlugins\ERE\__init__.py:136
msgid "Updates will be checked automatically when launching NVDA."
msgstr "NVDAを起動するときに、自動的にアップデートがチェックされます。"

#: addon\globalPlugins\ERE\__init__.py:136
msgid "Updates will not be checked when launching NVDA."
msgstr "NVDAを起動するときに、アップデートはチェックされません。"

#: addon\globalPlugins\ERE\__init__.py:138
#: addon\globalPlugins\ERE\__init__.py:154
