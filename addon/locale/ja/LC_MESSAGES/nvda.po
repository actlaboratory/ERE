msgid "Settings changed"
msgstr "設定変更完了"

#: addon\globalPlugins\ERE\__init__.py:152
msgid "English Reading Enhancer has been enabled."
msgstr "English Reading Enhancerを有効にしました。"

#: addon\globalPlugins\ERE\__init__.py:152
msgid "English Reading Enhancer has been disabled."
msgstr "English Reading Enhancerを無効にしました。"

#: addon\globalPlugins\ERE\__init__.py:170
msgid "Disable English Reading Enhancer"
msgstr "English Reading Enhancerを無効化"

#: addon\globalPlugins\ERE\__init__.py:170
msgid "Enable English Reading Enhancer"
msgstr "English Reading Enhancerを有効化"

#: addon\globalPlugins\ERE\__init__.py:175
msgid "All English words will be spelled out letter by letter."
msgstr "すべての英単語をアルファベット読みするようになりました。"

#: addon\globalPlugins\ERE\__init__.py:175
msgid "English words will be converted to Japanese pronunciation normally."
msgstr "英単語を通常どおりカナ読みに変換するようになりました。"

#: addon\globalPlugins\ERE\__init__.py:205
msgid "Failed to switch the dictionary. See the NVDA log for details."
msgstr "辞書の切り替えに失敗しました。詳細についてはNVDAのログを確認してください。"

